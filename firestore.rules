rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Custom Token claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    function isStaff() {
      // Staff must have the 'staff' or 'admin' custom claim set via Firebase Admin SDK.
      // The shared POS account (pos@faloodaandco.co.uk) must have this claim.
      // Set it via: admin.auth().setCustomUserClaims(uid, { staff: true })
      return request.auth != null && (request.auth.token.staff == true || request.auth.token.admin == true);
    }

    function hasModule(mod) {
      return request.auth != null && (
        request.auth.token.admin == true || 
        (request.auth.token.modules != null && request.auth.token.modules.hasAny([mod]))
      );
    }

    // Settings (Menu builder config) - Public read, Admin write
    // Exception: cfd_state_* documents are public-write (POS may use offline fallback auth)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (docId.matches('cfd_state_.*') && isStaff());
    }

    // Menu Items - Public read, Write for admin or staff with 'menu'/'itembuilder' module
    match /menu_items/{document=**} {
      allow read: if true;
      allow write: if hasModule('menu') || hasModule('itembuilder');
    }

    // Orders - Public read (needed for print bridge), public create (web checkout)
    // Write access remains restricted to staff
    match /orders/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaff() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['needsPrinting', 'printed', 'printStatus']));
      allow delete: if isStaff();
    }

    // Mail queue - Public can create (order alerts), only Admin can read/update
    match /mail/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Bookings - Public can create (book table), only Staff can read or update
    match /bookings/{document=**} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }
    
    // Leads - Public can create (with strict validation), only Admin can read/update
    match /leads/{document=**} {
      allow create: if true 
        // Must contain only the expected fields
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'tenantId', 'campaign', 'createdAt', 'voucherCode', 'branch', 'source'])
        // Fields must be of the correct type
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt is string
        // Basic length/content validation to prevent massive payload spam
        && request.resource.data.name.size() < 100;
        
      allow read, update, delete: if isAdmin();
    }

    // Print Queue - Public read/write (bridge reads, POS writes)
    // POS may run with offline PIN auth (no Firebase token)
    match /print_queue/{document=**} {
      allow read, write: if true;
    }

    // Drawer logs - Staff can log drawer opens
    match /drawer_logs/{document=**} {
      allow write: if isStaff();
    }

    // Review queue and private feedback — Cloud Functions write, Admin reads
    match /review_queue/{document=**} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions write via Admin SDK
    }
    match /private_feedback/{document=**} {
      allow read: if isAdmin();
      allow create: if true; // Anonymous customers can submit feedback
      allow update, delete: if isAdmin();
    }

    // ─── Staff & Scheduling Collections ───
    // Secured via Go backend custom tokens (IAM fix applied 2026-05-12)

    // Staff records — read for staff, write for admin
    match /staff/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Shifts (clock in/out records) — read/write for staff
    match /shifts/{document=**} {
      allow read, write: if isStaff();
    }

    // Rota (weekly schedule) — read for staff, write for admin or 'staff' module
    match /rota/{document=**} {
      allow read: if isStaff();
      allow write: if hasModule('staff');
    }

    // Staff availability (for scheduling)
    match /staff_availability/{document=**} {
      allow read, write: if isStaff();
    }

    // Customer loyalty profiles — Zero-Trust Security Lockdown
    // Reads are restricted to the authenticated customer (via Phone Auth) OR staff.
    // Writes are strictly Admin-only (handled securely via Go Backend).
    match /customers/{document=**} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == document);
      allow write: if isAdmin();
    }

    // User profiles - users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny — everything else requires admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
